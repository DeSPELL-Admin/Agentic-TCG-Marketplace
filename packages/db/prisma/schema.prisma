generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth", "catalog", "market", "agent", "trading", "payment"]
}

// 나머지 모델은 담당자 합의 후 추가한다. 거래·결제 모델을 임의로 확정하지 않는다.
model CardVariant {
  id         String  @id @default(uuid()) @db.Uuid
  game       String  @default("POKEMON")
  name       String
  setCode    String
  cardNumber String
  language   String
  edition    String
  condition  String
  imageUrl   String?
  priceObservations PriceObservation[]

  @@unique([game, setCode, cardNumber, language, edition, condition])
  @@index([name])
  @@schema("catalog")
}

enum PriceDataSource {
  MOCK
  MARKET

  @@schema("catalog")
}

model PriceObservation {
  id            String          @id @default(uuid()) @db.Uuid
  cardVariantId String          @db.Uuid
  cardVariant   CardVariant     @relation(fields: [cardVariantId], references: [id], onDelete: Restrict)
  amount        String
  dataSource    PriceDataSource
  source        String
  observedAt    DateTime        @db.Timestamptz(3)

  @@index([cardVariantId, dataSource, observedAt])
  @@schema("catalog")
}

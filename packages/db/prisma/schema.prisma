generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth", "catalog", "market", "agent", "trading", "payment"]
}

// 나머지 모델은 담당자 합의 후 추가한다. 거래·결제 모델을 임의로 확정하지 않는다.
model CardVariant {
  id         String  @id @default(uuid()) @db.Uuid
  game       String  @default("POKEMON")
  name       String
  setCode    String
  cardNumber String
  language   String
  edition    String
  condition  String
  imageUrl   String?

  @@unique([game, setCode, cardNumber, language, edition, condition])
  @@index([name])
  @@schema("catalog")
}
